{
  "name": "html-templates",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/capture-thumbnails.mjs --changed && node --check scripts/showcase-lib.mjs && node --check scripts/showcase-server.mjs && node scripts/generate-showcase.mjs",
    "dev": "HOST=127.0.0.1 PORT=4321 node scripts/showcase-server.mjs",
    "start": "node scripts/showcase-server.mjs",
    "test": "node --test",
    "thumbnails": "node scripts/capture-thumbnails.mjs",
    "pretest": "node scripts/ensure-qa-browser.mjs",
    "test:qa": "node scripts/ensure-qa-browser.mjs && node --test test/qa-browser.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "playwright": "^1.56.1"
  }
}
